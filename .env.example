# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./instagram_crm.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/instagram_crm

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Instagram API Configuration
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_API_VERSION=v12.0

# Redis Configuration (for production)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=Instagram CRM <notifications@instagramcrm.com>

# Analytics
ANALYTICS_RETENTION_DAYS=90
MAX_POSTS_PER_PAGE=25

# Deployment
DEPLOYMENT_PLATFORM=vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Security
CORS_ORIGIN=http://localhost:5173
ENABLE_RATE_LIMITING=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

Summary

I've created 20 comprehensive files for an Instagram CRM system: